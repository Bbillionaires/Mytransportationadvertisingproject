# Copy to .env and fill in. PLACEHOLDERS ONLY — never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://rmn:CHANGE_ME@localhost:5432/rmn_dev
# Integration tests DROP and recreate the public schema of this database. Never point it at real data.
TEST_DATABASE_URL=postgres://rmn:CHANGE_ME@localhost:5432/rmn_test
# 32 random bytes, base64 (openssl rand -base64 32). Use a secret manager in production.
APP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SESSION_TTL_MINUTES=480
DEVICE_CLOCK_SKEW_SECONDS=300
# 32 random bytes, base64. Signs expiring media URLs; the CDN edge verifies with the same key.
MEDIA_SIGNING_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
MEDIA_BASE_URL=https://media.invalid
PLAYLIST_TTL_MINUTES=15
# Local media storage (dev). Production: object storage + CDN verifying signed URLs.
MEDIA_ROOT=./var/media
MAX_UPLOAD_BYTES=2147483648
ALLOCATION_SETTLE_MINUTES=60
ALLOCATION_WINDOW_MINUTES=60
# Payments (TEST MODE ONLY). 'fake' runs an in-process Stripe stand-in for dev/demo.
PAYMENTS_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_TEST_SECRET
STRIPE_DRIVER_PRICE_ID=price_REPLACE
APP_PUBLIC_URL=http://127.0.0.1:8080
# Bearer token for GET /metrics (Prometheus scrape). Unset = disabled.
# METRICS_TOKEN=REPLACE_WITH_RANDOM_32_CHARS
# Hard-locked to false in config validation until live payments are approved (DECISIONS.md D-010).
LIVE_PAYMENTS_ENABLED=false
# Demo seed only (synthetic data). Leave unset to generate a random password.
SEED_PASSWORD=
